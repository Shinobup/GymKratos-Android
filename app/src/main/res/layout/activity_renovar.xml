<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="RENOVAR MEMBRESÍA"
            android:textAlignment="center"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp"
            android:layout_marginTop="32dp"/>

        <!-- Contenedor para mostrar los clientes vencidos -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Avisos de Vencimiento:"
            android:textColor="#AAAAAA"
            android:layout_marginBottom="8dp"/>

        <LinearLayout
            android:id="@+id/contenedorVencidos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp"/>

        <!-- Selector del cliente a renovar -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Selecciona Cliente a Renovar:"
            android:textColor="#AAAAAA"
            android:layout_marginBottom="8dp"/>

        <Spinner
            android:id="@+id/spinnerClientesRenovar"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:backgroundTint="#B71C1C"
            android:layout_marginBottom="24dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nuevas Disciplinas (Puedes elegir varias):"
            android:textColor="#AAAAAA"
            android:layout_marginBottom="8dp"/>

        <!-- Grupo de CheckBoxes -->
        <CheckBox
            android:id="@+id/cbKickboxingRenovar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Kickboxing"
            android:textColor="#FFFFFF"
            android:buttonTint="#B71C1C"/>

        <CheckBox
            android:id="@+id/cbBoxeoRenovar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Boxeo"
            android:textColor="#FFFFFF"
            android:buttonTint="#B71C1C"/>

        <CheckBox
            android:id="@+id/cbJiujitsuRenovar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Jiujitsu"
            android:textColor="#FFFFFF"
            android:buttonTint="#B71C1C"/>

        <CheckBox
            android:id="@+id/cbGymRenovar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Gym (Pesas)"
            android:textColor="#FFFFFF"
            android:buttonTint="#B71C1C"/>

        <CheckBox
            android:id="@+id/cbPersonalizadoRenovar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Personalizado"
            android:textColor="#FFFFFF"
            android:buttonTint="#B71C1C"/>

        <CheckBox
            android:id="@+id/cbPlanEspecialRenovar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Plan Especial"
            android:textColor="#FFFFFF"
            android:buttonTint="#B71C1C"
            android:layout_marginBottom="24dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Valor de la Mensualidad ($):"
            android:textColor="#AAAAAA"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/inputMontoUnicoRenovar"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:hint="Ej: 35000"
            android:textColorHint="#888888"
            android:textColor="#FFFFFF"
            android:backgroundTint="#B71C1C"
            android:inputType="number"
            android:layout_marginBottom="32dp"/>

        <Button
            android:id="@+id/btnRenovarAccion"
            android:layout_width="match_parent"
            android:layout_height="65dp"
            android:text="🔄 RENOVAR MEMBRESÍA"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            app:backgroundTint="#B71C1C"
            app:cornerRadius="4dp"
            android:layout_marginBottom="12dp"/>

        <Button
            android:id="@+id/btnVolverDesdeRenovar"
            android:layout_width="match_parent"
            android:layout_height="65dp"
            android:text="VOLVER AL MENÚ"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            app:backgroundTint="#424242"
            app:cornerRadius="4dp"
            android:layout_marginBottom="32dp"/>

    </LinearLayout>
</ScrollView>