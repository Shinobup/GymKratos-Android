<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:padding="24dp">

    <!-- Título Fijo Arriba -->
    <TextView
        android:id="@+id/tvTituloVer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="LISTA DE CLIENTES"
        android:textAlignment="center"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp"/>

    <!-- EL INTERRUPTOR MÁGICO PARA VER LA LISTA GENERAL -->
    <Switch
        android:id="@+id/switchVerLista"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/tvTituloVer"
        android:text="Modo: Mis Clientes (Personalizados)"
        android:textColor="#B71C1C"
        android:textSize="16sp"
        android:textStyle="bold"
        android:visibility="gone"
        android:layout_marginBottom="16dp"
        android:thumbTint="#FFFFFF"
        android:trackTint="#424242"/>

    <!-- Mensaje de Estado / Cargando -->
    <TextView
        android:id="@+id/tvEstado"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/switchVerLista"
        android:text="⏳ Descargando base de datos..."
        android:textColor="#AAAAAA"
        android:textAlignment="center"
        android:layout_marginBottom="16dp"
        android:visibility="visible"/>

    <!-- Botón de Reconectar -->
    <Button
        android:id="@+id/btnReconectar"
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:layout_below="@id/tvEstado"
        android:text="🔄 REINTENTAR CONEXIÓN"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        app:backgroundTint="#B71C1C"
        app:cornerRadius="4dp"
        android:layout_marginBottom="16dp"
        android:visibility="gone"/>

    <!-- Lista Deslizable en el centro -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/btnReconectar"
        android:layout_above="@id/btnVolverDesdeLista"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:id="@+id/contenedorClientes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <!-- Botón Fijo Abajo -->
    <Button
        android:id="@+id/btnVolverDesdeLista"
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:layout_alignParentBottom="true"
        android:text="VOLVER AL MENÚ"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        app:backgroundTint="#424242"
        app:cornerRadius="4dp" />

</RelativeLayout>