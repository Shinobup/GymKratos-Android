<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="32dp"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Título -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="💪 GYM KRATOS 💪"
            android:textColor="#E53935"
            android:textSize="32sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <!-- Subtítulo -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MENÚ PRINCIPAL"
            android:textColor="#AAAAAA"
            android:textSize="14sp"
            android:letterSpacing="0.1"
            android:layout_marginBottom="40dp"/>

        <!-- Botón 1: Registrar -->
        <Button
            android:id="@+id/idRegistrar"
            android:layout_width="match_parent"
            android:layout_height="65dp"
            android:text="REGISTRAR NUEVO CLIENTE"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            app:backgroundTint="#B71C1C"
            app:cornerRadius="4dp"
            android:layout_marginBottom="12dp"/>

        <!-- Botón 2: Ver Clientes -->
        <Button
            android:id="@+id/idVer"
            android:layout_width="match_parent"
            android:layout_height="65dp"
            android:text="VER CLIENTES"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            app:backgroundTint="#B71C1C"
            app:cornerRadius="4dp"
            android:layout_marginBottom="12dp"/>

        <!-- Botón 3: Renovar -->
        <Button
            android:id="@+id/idRenovar"
            android:layout_width="match_parent"
            android:layout_height="65dp"
            android:text="RENOVAR MEMBRESÍA"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            app:backgroundTint="#B71C1C"
            app:cornerRadius="4dp"
            android:layout_marginBottom="12dp"/>

        <!-- Botón 4: Eliminar -->
        <Button
            android:id="@+id/idEliminar"
            android:layout_width="match_parent"
            android:layout_height="65dp"
            android:text="ELIMINAR CLIENTE"
            android:textColor="#E53935"
            android:textStyle="bold"
            app:backgroundTint="#212121"
            app:cornerRadius="4dp"
            android:layout_marginBottom="12dp"/>

        <!-- Botón 5: Avisos -->
        <Button
            android:id="@+id/idAvisos"
            android:layout_width="match_parent"
            android:layout_height="65dp"
            android:text="AVISOS DE WHATSAPP"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            app:backgroundTint="#2E7D32"
            app:cornerRadius="4dp"
            android:layout_marginBottom="12dp" />

        <!-- NUEVO Botón 6: Finanzas -->
        <Button
            android:id="@+id/idFinanzas"
            android:layout_width="match_parent"
            android:layout_height="65dp"
            android:text="💰 VER FINANZAS"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            app:backgroundTint="#F57C00"
            app:cornerRadius="4dp" />

    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>