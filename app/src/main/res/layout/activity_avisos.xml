<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:padding="24dp">

    <!-- Título Fijo Arriba -->
    <TextView
        android:id="@+id/tvTituloAvisos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="AVISOS DE COBRO"
        android:textAlignment="center"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp"/>

    <!-- Mensaje de Estado / Cargando -->
    <TextView
        android:id="@+id/tvEstadoAvisos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/tvTituloAvisos"
        android:text="⏳ Buscando clientes por vencer..."
        android:textColor="#AAAAAA"
        android:textAlignment="center"
        android:layout_marginBottom="16dp"
        android:visibility="visible"/>

    <!-- Lista Deslizable en el centro -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/tvEstadoAvisos"
        android:layout_above="@id/btnVolverDesdeAvisos"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:id="@+id/contenedorAvisos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <!-- Botón Fijo Abajo -->
    <Button
        android:id="@+id/btnVolverDesdeAvisos"
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:layout_alignParentBottom="true"
        android:text="VOLVER AL MENÚ"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        app:backgroundTint="#424242"
        app:cornerRadius="4dp" />

</RelativeLayout>